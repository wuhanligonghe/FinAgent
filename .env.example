# Optional local configuration, loaded from the directory containing finagent.toml.
# Existing process environment variables take priority. Do not commit .env.
FINAGENT_BASE_URL=https://your-provider.example/v1
FINAGENT_MODEL=your-tool-calling-model
FINAGENT_API_KEY=replace-with-your-key
# Ordinary Chat Completions gateways use eager loading. Native deferred loading
# requires an Anthropic Messages endpoint with tool_reference support.
FINAGENT_TOOL_LOADING=eager
FINAGENT_PROMPT_CACHING=false

# Primary short-term session/checkpoint/task/event storage; Redis must be running.
# Use rediss:// for a TLS endpoint; put credentials here rather than in TOML.
# FINAGENT_REDIS_URL=redis://127.0.0.1:6379/0

# Required MySQL business storage: use the runtime account, never a maintenance account.
# FINAGENT_MYSQL_URL=mysql+pymysql://finagent_app:replace-with-password@127.0.0.1:3306/finagent?charset=utf8mb4
# For the private local instance, use its unix_socket URL from the operator setup.
# Structural upgrades and SQLite import use a separate maintenance URL in the process environment.

# Optional model-only HTTP(S) proxy, also loaded when the shell has no proxy variables.
# FINAGENT_MODEL_PROXY=http://127.0.0.1:17897

# Independent proxy for financial sources. Set only if direct data access fails.
# FINAGENT_DATA_PROXY=http://127.0.0.1:17897

# Long-term memory: same user across sessions; separate IDs isolate owners/projects.
# FINAGENT_MEMORY_USER_ID=local
# FINAGENT_MEMORY_PROJECT_ID=finagent
# Web account identity comes from authentication, independently of this CLI scope.
# Create accounts interactively: finagent auth create-user yourname
# Configure deployment origins and limits in finagent.toml [auth]; never store passwords here.
# Default uses local Ollama /api/embed; pull qwen3-embedding:8b on its host first.
# FINAGENT_EMBEDDING_BACKEND=ollama
# FINAGENT_EMBEDDING_ENDPOINT=http://127.0.0.1:11434
# FINAGENT_EMBEDDING_MODEL=qwen3-embedding:8b
# For an existing OpenAI-compatible embedding service, use backend=openai,
# its API prefix (e.g. https://your-provider.example/v1), model, and separate key.
# FINAGENT_EMBEDDING_API_KEY=replace-with-your-embedding-key
# Dedicated Qwen3-Reranker-8B scorer; default does not call the main chat model.
# FINAGENT_MEMORY_RERANK=always
# FINAGENT_RERANK_BACKEND=http
# FINAGENT_RERANK_ENDPOINT=http://127.0.0.1:11436/v1
# FINAGENT_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
# FINAGENT_RERANK_API_KEY=replace-with-your-reranker-key
# FINAGENT_RERANK_TIMEOUT_SECONDS=30
# FINAGENT_RERANK_MIN_SCORE=0.5

# Stock Qwen3.5-9B intent/tool classification (no fine-tuning).
# Enabled in finagent.toml; exact social rules run first, failures use rule fallback.
# FINAGENT_INTENT_ENABLED=true
# FINAGENT_INTENT_ENDPOINT=http://127.0.0.1:11434
# FINAGENT_INTENT_MODEL=qwen3.5:9b

# Whole-answer review against task-scoped evidence, configured in [fact_check.review].
# Failures/incomplete evidence block unchecked drafts; no extractor request is made in this mode.
# FINAGENT_ANSWER_REVIEW_ENABLED=true
# FINAGENT_ANSWER_REVIEW_ENDPOINT=http://127.0.0.1:11435
# FINAGENT_ANSWER_REVIEW_MODEL=qwen3.5:9b

# Legacy fine-tuned Qwen3/Ollama understanding hints. Independent of [intent].
# Enable explicitly with [nlu].enabled=true.
# The default persistent Agent works without this service or model weights.
# Keep these commented to inherit [nlu] from finagent.toml.
# Overrides must match model_dir/manifest.json; never enable placeholder digests.
# FINAGENT_NLU_ENDPOINT=http://127.0.0.1:11434
# FINAGENT_NLU_MODEL=finagent-intent:qwen3.5-9b-v2-f16
# FINAGENT_NLU_MODEL_DIR=models/finagent-qwen3-intent
# FINAGENT_NLU_EXPECTED_DIGEST=64-lowercase-hex-characters
